     /* ------------------------------------------------------------------------------------------------------------- */
     /*                                                                                                               */
     /* Project . . . : IceBreak                                                                                      */
     /* Design  . . . : Niels Liisberg                                                                                */
     /* Function  . . : Sample send to dataqueu                                                                       */
     /*                                                                                                               */
     /* This example shows how to use the non blocking feature in icebreak                                            */
     /*                                                                                                               */
     /* The client can issue this from a XHR request                                                                  */
     /* and receive data independent of the normal application server flow                                            */
     /*                                                                                                               */
     /* http://myibmi:60000/system/rcvdtaq?lib=QGPL&dtaq=MYMESSAGES&key=JOHN&keylen=10&keytype=EQ&timeout=60          */
     /*                                                                                                               */
     /* Compile: CRTBNDCL PGM(MYLIB/ICEDTAQ) SRCSTMF('/www/IceBreak-Samples/server-exits/iceDtaq.clle') */
     /*                                                                                                               */
     /* By       Date       Task    Description                                                                       */
     /* -------- ---------- ------- --------------------------------------------------------------------------------- */
     /* NLI      14.10.2020 0000000 New program                                                                       */
     /* ------------------------------------------------------------------------------------------------------------- */
     pgm
        dcl    &len     type(*dec)  len(5 0)
        dcl    &data    type(*char) len(4096)
        dcl    &keyLen  type(*DEC)  len(3 0) value(10)

        crtdtaq dtaq(qgpl/mymessages) maxlen(4096) seq(*keyed) keylen(10)
        monmsg cpf0000

        chgvar &data ('Hello world')
        chgvar &len  (11)

        call  qsnddtaq (mymessages qgpl &len &data &keylen john)
     endpgm
